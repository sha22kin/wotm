<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # 1. Prevent direct access to sensitive system files and folders
    RewriteRule ^\.(?!well-known).* - [F,L,NC]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|tests|vendor)(/.*)?$ - [F,L,NC]
    RewriteRule ^storage/(app|framework|logs)(/.*)?$ - [F,L,NC]
    RewriteRule ^(\.env.*|composer\.(json|lock)|package\.(json|lock)|phpunit\.xml|vite\.config\.js|artisan) - [F,L,NC]

    # 2. Prevent rewrite loop if request is already targeting /public
    RewriteCond %{REQUEST_URI} ^/public/ [NC]
    RewriteRule ^ - [L]

    # 3. Route all traffic (CSS, JS, images, routes) to public folder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>
